# Verde de Novo - example environment file.
# Copy to .env and fill in. Command-line arguments (--argX) override these values.
# The cloud API key is held ONLY by the backend proxy, never in the client.

# Server
HOST=0.0.0.0
PORT=8000
STATIC_DIR=dist
# If PORT is busy, try the next free one (true/false)
PORT_SEARCH=true

# Vision vendor. Only "stub" exists for now (offline, fake answers). URL/key are reserved for the real vendor.
VISION_PROVIDER=stub
VISION_API_KEY=
VISION_API_URL=

# Minimum confidence for each analysis step
CONFIDENCE_THRESHOLD=0.6
# Upload guard rails
MAX_IMAGE_MB=2.5
# Rate limit: RATE_LIMIT requests per RATE_WINDOW seconds per client
RATE_LIMIT=10
RATE_WINDOW=60
