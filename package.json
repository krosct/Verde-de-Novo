{
  "name": "verde-de-novo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Photo of a whole houseplant in; species, conditions per part and care suggestions out. Not a diagnosis.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "$HOME/.venv/bin/python -m uvicorn server.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && $HOME/.venv/bin/python -m server --host 0.0.0.0 --port 8000",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:py": "$HOME/.venv/bin/python -m pytest -q"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.0.0"
  }
}
